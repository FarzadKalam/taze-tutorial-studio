# فقط مسیر سورس؛ هیچ اتصال production از این تنظیم ساخته نمی‌شود.
# پیش‌فرض سورس همسایهٔ این ریپو است؛ برای مسیر متفاوت این مقدار را تنظیم کنید.
KALAMAPP_ROOT=../Kalamapp
# اختیاری؛ در cloud با npm run setup آماده می‌شود، در ویندوز مرورگر موجود تشخیص داده می‌شود.
TUTORIAL_BROWSER_PATH=
# مسیر اختیاری فایل‌های موقت رندر؛ وقتی فضای درایو پروژه کم است در درایو آزاد تنظیم کنید.
TUTORIAL_TEMP_DIR=
# فقط در صورت نیاز برای گزارش محیط؛ این مقدار سرور ابری نمی‌سازد.
TUTORIAL_ENVIRONMENT_KIND=
# سرویس فعلی تازه‌سیستم؛ bearer متعلق به حساب تولیدکنندهٔ محتوا.
TAZE_AI_URL=
TAZE_AI_ANON_KEY=
TAZE_AI_ACCESS_TOKEN=
# کلیدها فقط در فایل .env محلی؛ هرگز داخل سناریو یا Git نباشند.
